{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apigw.local/schemas/plugins/ip-restriction.json",
  "title": "ip-restriction plugin",
  "description": "Allow or deny by client IP (derived via settings.trustedProxies). Deny wins; a non-empty allow list denies everything else.",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [{ "required": ["allow"] }, { "required": ["deny"] }],
  "properties": {
    "allow": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/cidr" } },
    "deny": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/cidr" } },
    "status": { "type": "integer", "minimum": 400, "maximum": 499, "default": 403 }
  },
  "$defs": {
    "cidr": { "type": "string", "description": "IPv4/IPv6 address or CIDR, e.g. 10.0.0.0/8 or 2001:db8::/32", "maxLength": 64 }
  }
}
