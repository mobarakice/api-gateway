{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apigw.local/schemas/plugins/cors.json",
  "title": "cors plugin",
  "description": "Answers CORS preflights at the gateway and sets CORS headers on responses, including gateway errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowOrigins"],
  "properties": {
    "allowOrigins": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(\\*|https?://(\\*\\.)?[a-z0-9.-]+(:[0-9]{1,5})?)$" }
    },
    "allowMethods": {
      "type": "array", "uniqueItems": true, "default": ["GET", "HEAD", "POST"],
      "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] }
    },
    "allowHeaders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "exposeHeaders": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "allowCredentials": { "type": "boolean", "default": false },
    "maxAgeSeconds": { "type": "integer", "minimum": 0, "maximum": 86400, "default": 600 }
  },
  "if": { "properties": { "allowCredentials": { "const": true } }, "required": ["allowCredentials"] },
  "then": { "properties": { "allowOrigins": { "not": { "contains": { "const": "*" } } } } },
  "$defs": {
    "name": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,256}$" }
  }
}
